// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Models ──────────────────────────────────────────────
model Language {
  code         String                 @id @map("code") @db.VarChar(10)
  name         String                 @map("name") @db.VarChar(100)
  isDefault    Boolean                @default(false) @map("is_default")
  users        User[]                 @relation("PreferredLanguage")
  translations MemoryPinTranslation[]

  @@map("languages")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        UserRoleName @map("name")
  description String?      @map("description") @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")
  userRoles   UserRole[] // vẫn giữ quan hệ với model UserRole

  @@unique([name])
  @@map("roles")
}

model User {
  id                Int       @id @default(autoincrement())
  email             String?   @unique @map("email") @db.VarChar(255)
  passwordHash      String?   @map("password_hash") @db.VarChar(255)
  firstName         String    @map("first_name") @db.VarChar(100)
  lastName          String    @map("last_name") @db.VarChar(100)
  displayName       String?   @map("display_name") @db.VarChar(200)
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  avatarUrl         String    @default("https://cdn.memorypin.app/default-avatar.png") @map("avatar_url") @db.VarChar(500)
  bio               String?   @map("bio") @db.Text
  preferredLanguage String    @default("vi") @map("preferred_language") @db.VarChar(10)
  isVerified        Boolean   @default(false) @map("is_verified")
  totpSecret        String?   @map("totp_secret") @db.VarChar(100)
  pendingTotpSecret String?   @map("pending_totp_secret") @db.VarChar(100)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")

  language            Language            @relation("PreferredLanguage", fields: [preferredLanguage], references: [code])
  userRoles           UserRole[]
  oauthAccounts       OauthAccount[]
  emailVerifications  EmailVerification[]
  refreshTokens       RefreshToken[]
  sentFriendships     Friendship[]        @relation("Requester")
  receivedFriendships Friendship[]        @relation("Addressee")
  blockedBy           BlockedUser[]       @relation("Blocker")
  blockedUsers        BlockedUser[]       @relation("Blocked")
  backupCodes         UserBackupCode[]
  createdPlaces       Place[]             @relation("CreatedBy")
  memoryPins          MemoryPin[]
  upvotes             Upvote[]
  comments            Comment[]
  reports             Report[]            @relation("Reporter")
  handledReports      Report[]            @relation("Handler")
  devices             UserDevice[]
  notifications       Notification[]
  grantedRoles        UserRole[]          @relation("GrantedBy")

  @@map("users")
}

model UserRole {
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  grantedBy Int?     @map("granted_by")
  grantedAt DateTime @default(now()) @map("granted_at")

  user    User  @relation(fields: [userId], references: [id])
  role    Role  @relation(fields: [roleId], references: [id])
  grantor User? @relation("GrantedBy", fields: [grantedBy], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model OauthAccount {
  id             Int           @id @default(autoincrement())
  userId         Int           @map("user_id")
  provider       OauthProvider @map("provider")
  providerUserId String        @map("provider_user_id") @db.VarChar(255)
  accessToken    String?       @map("access_token") @db.VarChar(500)
  refreshToken   String?       @map("refresh_token") @db.VarChar(500)
  tokenExpiresAt DateTime?     @map("token_expires_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @map("token") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("email_verifications")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @map("token") @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model Friendship {
  id          Int              @id @default(autoincrement())
  requesterId Int              @map("requester_id")
  addresseeId Int              @map("addressee_id")
  status      FriendshipStatus @default(PENDING) @map("status")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime?        @updatedAt @map("updated_at")

  requester User @relation("Requester", fields: [requesterId], references: [id])
  addressee User @relation("Addressee", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, requesterId])
  @@map("friendships")
}

model BlockedUser {
  id            Int      @id @default(autoincrement())
  blockerId     Int      @map("blocker_id")
  blockedUserId Int      @map("blocked_user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedUserId], references: [id])

  @@unique([blockerId, blockedUserId])
  @@index([blockedUserId])
  @@map("blocked_users")
}

model UserBackupCode {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  codeHash  String   @map("code_hash") @db.VarChar(255)
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isUsed])
  @@map("user_backup_codes")
}

model PlaceType {
  id        Int      @id @default(autoincrement())
  name      String   @map("name") @db.VarChar(100)
  icon      String?  @map("icon") @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  places Place[]

  @@map("place_types")
}

model Place {
  id          Int                     @id @default(autoincrement())
  name        String                  @map("name") @db.VarChar(200)
  description String?                 @map("description") @db.Text
  address     String?                 @map("address") @db.VarChar(500)
  imageUrl    String?                 @map("image_url") @db.VarChar(500)
  location    Unsupported("geometry") @map("location") // PostGIS point (SRID 4326)
  placeTypeId Int                     @map("place_type_id")
  visibility  PlaceVisibility         @default(PUBLIC) @map("visibility")
  createdBy   Int?                    @map("created_by")
  createdAt   DateTime                @default(now()) @map("created_at")

  placeType PlaceType   @relation(fields: [placeTypeId], references: [id])
  creator   User?       @relation("CreatedBy", fields: [createdBy], references: [id])
  pins      MemoryPin[]

  @@index([placeTypeId])
  // Manually create spatial index: CREATE INDEX idx_places_location ON places USING GIST (location);
  @@map("places")
}

model MemoryPin {
  id          Int                      @id @default(autoincrement())
  userId      Int                      @map("user_id")
  placeId     Int?                     @map("place_id")
  title       String                   @map("title") @db.VarChar(255)
  description String?                  @map("description") @db.Text
  audioUrl    String?                  @map("audio_url") @db.VarChar(500)
  imageUrl    String?                  @map("image_url") @db.VarChar(500)
  year        Int?                     @map("year")
  tags        String[]                 @map("tags")
  location    Unsupported("geometry")  @map("location") // PostGIS point (SRID 4326)
  visibility  PinVisibility            @default(FRIENDS) @map("visibility")
  isHidden    Boolean                  @default(false) @map("is_hidden")
  status      PinStatus                @default(PUBLISHED) @map("status")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime?                @updatedAt @map("updated_at")
  deletedAt   DateTime?                @map("deleted_at")
  tsv         Unsupported("tsvector")? @map("tsv") // generated tsvector column

  user         User                   @relation(fields: [userId], references: [id])
  place        Place?                 @relation(fields: [placeId], references: [id])
  translations MemoryPinTranslation[]
  upvotes      Upvote[]
  comments     Comment[]
  reports      Report[]

  @@index([userId])
  @@index([placeId])
  @@index([year])
  @@index([status])
  @@index([isHidden])
  // Composite index for timeline: CREATE INDEX idx_pins_timeline ON memory_pins (year, visibility, created_at) WHERE status = 'published' AND is_hidden = false;
  // Spatial index: CREATE INDEX idx_pins_location ON memory_pins USING GIST (location);
  // GIN index for tags: CREATE INDEX idx_pins_tags ON memory_pins USING GIN (tags);
  // GIN index for full-text search: CREATE INDEX idx_pins_tsv ON memory_pins USING GIN (tsv);
  @@map("memory_pins")
}

model MemoryPinTranslation {
  id           Int                      @id @default(autoincrement())
  pinId        Int                      @map("pin_id")
  languageCode String                   @map("language_code") @db.VarChar(10)
  title        String                   @map("title") @db.VarChar(255)
  description  String?                  @map("description") @db.Text
  createdAt    DateTime                 @default(now()) @map("created_at")
  tsv          Unsupported("tsvector")? @map("tsv") // generated tsvector column

  pin      MemoryPin @relation(fields: [pinId], references: [id])
  language Language  @relation(fields: [languageCode], references: [code])

  @@unique([pinId, languageCode])
  // GIN index: CREATE INDEX idx_trans_tsv ON memory_pin_translations USING GIN (tsv);
  @@map("memory_pin_translations")
}

model Upvote {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  pinId     Int      @map("pin_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User      @relation(fields: [userId], references: [id])
  pin  MemoryPin @relation(fields: [pinId], references: [id])

  @@unique([userId, pinId])
  @@map("upvotes")
}

model Comment {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  pinId     Int      @map("pin_id")
  parentId  Int?     @map("parent_id")
  content   String   @map("content") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user    User      @relation(fields: [userId], references: [id])
  pin     MemoryPin @relation(fields: [pinId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([pinId, createdAt])
  @@map("comments")
}

model Report {
  id             Int          @id @default(autoincrement())
  reporterUserId Int          @map("reporter_user_id")
  pinId          Int          @map("pin_id")
  reason         String       @map("reason") @db.Text
  status         ReportStatus @default(PENDING) @map("status")
  handledBy      Int?         @map("handled_by")
  handledAt      DateTime?    @map("handled_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  reporter User      @relation("Reporter", fields: [reporterUserId], references: [id])
  pin      MemoryPin @relation(fields: [pinId], references: [id])
  handler  User?     @relation("Handler", fields: [handledBy], references: [id])

  @@unique([reporterUserId, pinId])
  @@map("reports")
}

model UserDevice {
  id          Int             @id @default(autoincrement())
  userId      Int             @map("user_id")
  deviceToken String          @map("device_token") @db.VarChar(500)
  platform    DevicePlatform? @map("platform")
  createdAt   DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, deviceToken])
  @@map("user_devices")
}

model Notification {
  id            Int              @id @default(autoincrement())
  userId        Int              @map("user_id")
  type          NotificationType @map("type")
  referenceId   Int?             @map("reference_id")
  referenceType ReferenceType?   @map("reference_type")
  payload       Json?            @map("payload") @db.JsonB
  isRead        Boolean          @default(false) @map("is_read")
  createdAt     DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ── Enums ───────────────────────────────────────────────

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  UNFRIENDED
}

enum PinVisibility {
  PUBLIC
  FRIENDS
  ONLY_ME
}

enum PinStatus {
  PUBLISHED
  DRAFT
  HIDDEN
  DELETED
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPT
  NEW_PIN_FROM_FRIEND
  UPVOTE
  COMMENT
  REPORT_RESULT
}

enum DevicePlatform {
  PHONE
  WEB
}

enum PlaceVisibility {
  PUBLIC
  PRIVATE
}

enum OauthProvider {
  GOOGLE
}

enum ReferenceType {
  PIN
  FRIENDSHIP
  COMMENT
  REPORT
  BLOCK
}

enum UserRoleName {
  ADMIN
  MODERATOR
  USER
}
